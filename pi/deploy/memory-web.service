[Unit]
Description=Memory Cloud album
After=network.target

[Service]
User=memory
Group=memory
WorkingDirectory=/opt/memory-cloud
EnvironmentFile=/etc/memory-cloud.env
ExecStart=/opt/memory-cloud/.venv/bin/gunicorn --workers 1 --threads 4 --bind 127.0.0.1:8000 'app:create_app()'
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/memory-cloud

[Install]
WantedBy=multi-user.target
