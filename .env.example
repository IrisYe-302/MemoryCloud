# Copy to .env, edit, then load with: set -a; source .env; set +a
# Relative paths below assume commands are run from the repository root.
MEMORY_DATA=./data/local
MEMORY_PASSWORD=replace-with-a-long-random-setup-password
# Local HTTP only. Set to 1 on the Pi behind the trusted HTTPS proxy.
MEMORY_HTTPS=0
# Optional: needed only for AI caption generation. Never commit a real key.
OPENAI_API_KEY=
